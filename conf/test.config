// Toy-data test profile
// Uses first 25000 reads from Briney SRA data

workDir = "/data/scratch/work"

params {
    input    = "${projectDir}/assets/samplesheet.csv"
    outdir   = "/data/scratch/subset_test_results"

    cprimers = "${projectDir}/data/Briney_Cregion_primers.fasta"

    // Conservative params for toy data
    splitseq_min_count = 2
    clonal_threshold   = 0.16

    // Resource limits for local testing (WSL2 has ~7.7 GB available)
    max_cpus   = 4
    max_memory = '6.GB'
    max_time   = '2.h'
}

process {
    withLabel: 'process_medium' {
        memory = '4.GB'
        cpus   = 4
    }
    withLabel: 'process_high' {
        memory = '6.GB'
        cpus   = 4
    }
}
