// Toy-data test profile
// Uses first 25000 reads from Briney SRA data

params {
    input    = "${projectDir}/assets/samplesheet_template.csv"
    outdir   = "${projectDir}/test_results"

    // C-region primers from Briney 2019 — CH1 primer visible in R2 data
    // Override with: --cprimers /path/to/your/cprimers.fasta
    cprimers = "${projectDir}/assets/cprimers_briney2019.fasta"

    // Conservative params for toy data
    splitseq_min_count = 2
    clonal_threshold   = 0.16

    // Resource limits for local testing (WSL2 has ~7.7 GB available)
    max_cpus   = 4
    max_memory = '6.GB'
    max_time   = '2.h'
}
