manifest {
    name            = 'nf-immcantation'
    author          = 'Allovista'
    description     = 'Bulk BCR-IGH AIRR-seq pipeline using the Immcantation framework'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.0'
}

params {
    // I/O
    input                     = null
    outdir                    = null

    // FASTQ provenance (informational)
    library_generation_method = 'specific_pcr'
    platform                  = 'illumina_hiseq'

    // Primers
    cprimers                  = null    // C-region primers FASTA for MaskPrimers on R2

    // fastp
    fastp_q                   = 20     // qualified_quality_phred
    fastp_window_size         = 5      // sliding window size for 3' quality trim

    // MaskPrimers
    primer_maxerror           = 0.3

    // AssemblePairs sequential
    ap_maxerror               = 0.3
    ap_alpha                  = 1e-5
    ap_minident               = 0.5
    ap_evalue                 = 1e-5

    // CollapseSeq / SplitSeq
    splitseq_min_count        = 2

    // Clonal analysis — fixed threshold (no auto-detection)
    clonal_threshold          = 0.16
    clonal_dist_model         = 'ham'
    clonal_norm               = 'len'
    clonal_mode               = 'gene'
    cloneby                   = 'subject_id'

    // Output
    publish_dir_mode          = 'copy'
}

process {
    shell = ['bash', '-euo', 'pipefail']

    withLabel: 'immcantation' {
        container = 'docker.io/immcantation/suite:4.5.0'
    }
}

env {
    R_PROFILE_USER = 'NULL'
    R_LIBS_USER    = 'NULL'
}

profiles {
    docker {
        docker.enabled   = true
        docker.registry  = 'docker.io'
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    local {
        process.executor = 'local'
    }
    aws_batch {
        process.executor = 'awsbatch'
        // Stubs — configure before running on AWS:
        // aws.region        = 'us-east-1'
        // aws.batch.queue   = 'your-job-queue'
        // workDir           = 's3://your-bucket/nf-work'
        // docker.registry   = 'docker.io'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

plugins {
    id 'nf-schema@2.3.0'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Execution reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
