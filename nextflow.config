manifest {
    name            = 'nf-immcantation'
    author          = 'Allovista'
    description     = 'Bulk BCR-IGH AIRR-seq pipeline using the Immcantation framework'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.0'
}

params {
    // I/O
    input                     = null
    outdir                    = null

    // FASTQ provenance (informational)
    library_generation_method = 'specific_pcr'
    platform                  = 'illumina_hiseq'

    // Primers
    cprimers                  = null    // C-region (isotype) primers FASTA — masked on R1 (C-read)
    vprimers                  = null    // V-region primers FASTA — masked on R2 (V-read)

    // fastp
    fastp_q                   = 20     // qualified_quality_phred
    fastp_window_size         = 5      // sliding window size for 3' quality trim

    // MaskPrimers
    primer_maxerror_c         = 0.3    // C-primer mismatch tolerance (UMI+offset preamble noise)
    primer_maxerror_v         = 0.2    // V-primer mismatch tolerance (short, well-defined)
    primer_maxlen_c           = 100    // search window on R1: covers 12 nt UMI + 2/4/6 nt offset
    primer_maxlen_v           = 35     // search window on R2: covers 2/4/6 nt offset only

    // PEAR paired-end read merger
    pear_pvalue               = 0.01
    pear_min_overlap          = 10
    pear_min_assembly_length  = 50
    pear_max_assembly_length  = 0

    // CollapseSeq / SplitSeq
    splitseq_min_count        = 2

    // Clonal analysis
    cloning_method            = 'hierarchical'  // 'hierarchical' = SCOPer hierarchicalClones (default on main)
                                                // 'exact' = DefineClones --model aa --dist 0 (Briney parity)
    cloneby                   = 'subject_id'

    // 'exact' (DefineClones) — Briney clonotype = exact (V_gene, J_gene, CDR3_aa)
    defineclones_model        = 'aa'     // aa | ham | hh_s1f | hh_s5f | mk_rs1nf | mk_rs5nf
    defineclones_dist         = 0.0      // 0 = exact match
    defineclones_norm         = 'len'    // length-normalised (irrelevant at dist=0)

    // 'hierarchical' (SCOPer) — only used when cloning_method = 'hierarchical'
    clonal_threshold          = 0.16     // junction distance cutoff (hamming, length-normalised)
    scoper_method             = 'nt'     // 'nt' = hierarchicalClones; 'novj' = spectralClones
    scoper_linkage            = 'single' // single linkage maximizes sensitivity at diagnosis (Gupta et al. 2017)

    // Threshold mode: 'fixed' clusters with clonal_threshold only;
    // 'disttonearest' also computes the data-driven valley per patient and
    // warns on drift (clustering still uses the fixed clonal_threshold).
    clone_threshold_mode      = 'fixed'  // 'fixed' | 'disttonearest'
    threshold_drift_tol       = 0.04     // warn if |detected - clonal_threshold| exceeds this

    // Output
    publish_dir_mode          = 'symlink'

    // Resource defaults (override per-profile or via CLI --max_memory etc.)
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'

    // External reference directory (bind-mounted into containers at runtime)
    // Must contain:
    //   igblast/database/imgt_human_ig_{v,d,j}.*     (AssignGenes)
    //   igblast/internal_data/human/                 (AssignGenes)
    //   igblast/optional_file/human_gl.aux           (AssignGenes)
    //   germlines/imgt/human/vdj/imgt_human_IGH*.fasta (MakeDb)
    ref_dir                   = "${projectDir}/refs"
}

process {
    shell = ['bash', '-euo', 'pipefail']

    withLabel: 'presto' {
        container = 'fmarchiano/nf-immcantation-presto:0.7.2'
    }

    withLabel: 'pear' {
        container = 'fmarchiano/pear:0.9.11'
    }

    withLabel: 'changeo' {
        container = 'fmarchiano/nf-immcantation-changeo:1.3.0'
    }

    withLabel: 'scoper' {
        container = 'fmarchiano/nf-immcantation-scoper:1.5.0'
    }
}

env {
    R_PROFILE_USER = 'NULL'
    R_LIBS_USER    = 'NULL'
}

// Base resource tiers — included FIRST so profile-specific overrides win
includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled   = true
        docker.registry  = 'docker.io'
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    local {
        process.executor = 'local'
    }
    aws_batch {
        process.executor = 'awsbatch'
        process.queue    = 'nf-immcantation-fargate'

        aws.region                     = 'us-east-1'
        aws.batch.platformType         = 'fargate'
        aws.batch.executionRole        = 'arn:aws:iam::035260058162:role/ecsTaskExecutionRole'
        aws.batch.jobRole              = 'arn:aws:iam::035260058162:role/nextflow-job-role'
        aws.batch.maxParallelTransfers = 16
        aws.batch.maxTransferAttempts  = 3

        // Wave Freeze: build augmented containers ONCE, store in our ECR.
        // Subsequent tasks pull from ECR directly — no per-task Wave call,
        // no handshake_failure churn during the actual run.
        // Tower provides ECR push credentials (configured via env var).
        wave {
            enabled = true
            freeze  = true
            build {
                repository = '035260058162.dkr.ecr.us-east-1.amazonaws.com/nf-immcantation-frozen'
            }
            retryPolicy {
                maxAttempts = 10
                delay       = '5s'
                maxDelay    = '60s'
                jitter      = 0.25
            }
        }
        tower {
            enabled     = true
            accessToken = System.getenv('TOWER_ACCESS_TOKEN')
            workspaceId = '99735324731614'
        }

        workDir = 's3://imm-test-bucket-allovista/work'

        // Fargate accepts CPU only at {0.25, 0.5, 1, 2, 4, 8, 16}; memory tied to
        // vCPU tier in fixed increments. Pin labels to valid (vCPU, mem) combos —
        // overrides the task.attempt-scaling in base.config that would otherwise
        // produce illegal sizes on retry.
        process {
            errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'finish' }
            maxRetries    = 5

            withLabel: process_single { cpus = 1;  memory = 6.GB  }
            withLabel: process_low    { cpus = 2;  memory = 12.GB }
            withLabel: process_medium { cpus = 8;  memory = 36.GB }
            withLabel: process_high   { cpus = 16; memory = 72.GB }

            // CollapseSeq holds the whole assembled fastq in memory while
            // deduplicating. On full-size samples this exceeds 60 GB.
            // Use the 16 vCPU Fargate tier and pin to the maximum 120 GB.
            withName: PRESTO_COLLAPSESEQ { cpus = 16; memory = 120.GB }
        }
    }
    test {
        params.max_memory = '6.GB'
        params.max_cpus   = 4
        params.max_time   = '2.h'
        process {
            withLabel: 'process_medium' { memory = '4.GB'; cpus = 4 }
            withLabel: 'process_high'   { memory = '6.GB'; cpus = 4 }
        }
        includeConfig 'conf/test.config'
    }
}

plugins {
    id 'nf-schema@2.3.0'
}

includeConfig 'conf/modules.config'

// Execution reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
