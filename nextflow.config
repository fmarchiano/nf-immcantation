manifest {
    name            = 'nf-immcantation'
    author          = 'Allovista'
    description     = 'Bulk BCR-IGH AIRR-seq pipeline using the Immcantation framework'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.0'
}

params {
    // I/O
    input                     = null
    outdir                    = null

    // FASTQ provenance (informational)
    library_generation_method = 'specific_pcr'
    platform                  = 'illumina_hiseq'

    // Primers
    cprimers                  = null    // C-region primers FASTA for MaskPrimers on R2

    // fastp
    fastp_q                   = 20     // qualified_quality_phred
    fastp_window_size         = 5      // sliding window size for 3' quality trim

    // MaskPrimers
    primer_maxerror           = 0.3

    // PEAR paired-end read merger
    pear_pvalue               = 0.01
    pear_min_overlap          = 10
    pear_min_assembly_length  = 50
    pear_max_assembly_length  = 0

    // CollapseSeq / SplitSeq
    splitseq_min_count        = 2

    // Clonal analysis — SCOPer hierarchicalClones
    clonal_threshold          = 0.16     // junction distance cutoff (hamming, length-normalised)
    scoper_method             = 'nt'     // 'nt' = hierarchicalClones; 'novj' = spectralClones
    scoper_linkage            = 'complete' // maps --act set from DefineClones
    cloneby                   = 'subject_id'

    // Output
    publish_dir_mode          = 'symlink'

    // Resource defaults (override per-profile or via CLI --max_memory etc.)
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'

    // External reference directory (bind-mounted into containers at runtime)
    // Must contain:
    //   igblast/database/imgt_human_ig_{v,d,j}.*     (AssignGenes)
    //   igblast/internal_data/human/                 (AssignGenes)
    //   igblast/optional_file/human_gl.aux           (AssignGenes)
    //   germlines/imgt/human/vdj/imgt_human_IGH*.fasta (MakeDb)
    ref_dir                   = "${projectDir}/refs"
}

process {
    shell = ['bash', '-euo', 'pipefail']

    withLabel: 'presto' {
        container = 'fmarchiano/nf-immcantation-presto:0.7.2'
        containerOptions = "-v ${params.ref_dir}/igblast:/usr/local/share/igblast:ro"
    }

    withLabel: 'pear' {
        container = 'fmarchiano/pear:0.9.11'
    }

    withLabel: 'changeo' {
        container = 'fmarchiano/nf-immcantation-changeo:1.3.0'
        containerOptions = "-v ${params.ref_dir}/igblast:/usr/local/share/igblast:ro -v ${params.ref_dir}/germlines:/usr/local/share/germlines:ro"
    }

    withLabel: 'scoper' {
        container = 'fmarchiano/nf-immcantation-scoper:1.5.0'
    }
}

env {
    R_PROFILE_USER = 'NULL'
    R_LIBS_USER    = 'NULL'
}

profiles {
    docker {
        docker.enabled   = true
        docker.registry  = 'docker.io'
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    local {
        process.executor = 'local'
    }
    aws_batch {
        process.executor = 'awsbatch'
        // Stubs — configure before running on AWS:
        // aws.region        = 'us-east-1'
        // aws.batch.queue   = 'your-job-queue'
        // workDir           = 's3://your-bucket/nf-work'
        // docker.registry   = 'docker.io'
    }
    test {
        params.max_memory = '6.GB'
        params.max_cpus   = 4
        params.max_time   = '2.h'
        process {
            withLabel: 'process_medium' { memory = '4.GB'; cpus = 4 }
            withLabel: 'process_high'   { memory = '6.GB'; cpus = 4 }
        }
        includeConfig 'conf/test.config'
    }
}

plugins {
    id 'nf-schema@2.3.0'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Execution reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
